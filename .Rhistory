x = NULL,
# title = "Judge Scores by Dimension"
) +
base_theme +
theme(legend.position = c(0.85, 0.85), axis.text.x = element_text(angle = 0, hjust = 0.5),
legend.background = element_rect(colour ="black"))
p_left
# ── Right panel: Fabrication count ──
df_fab <- tibble(
Condition = factor(c("Structured\nSKILL", "Unstructured\nProse", "No Skill"),
levels = c("Structured\nSKILL", "Unstructured\nProse", "No Skill")),
Mean = c(2.0, 2.2, 3.9),
SD = c(0.991, 0.916, 1.208),
N = c(300, 300, 300)
) %>% mutate(SE = SD / sqrt(N))
fab_colors <- c("Structured\nSKILL" = "firebrick3", "Unstructured\nProse" = "pink", "No Skill" = "gray60")
p_right <- ggplot(df_fab, aes(x = Condition, y = Mean, fill = Condition)) +
geom_bar(stat = "identity",
position = position_dodge(),
alpha = 0.8, color = "black",linewidth = 0.3) +
geom_errorbar(
aes(ymin = Mean - SE, ymax = Mean + SE),
position = position_dodge(width = 0.9),
width = 0.2
) +
scale_fill_manual(values = fab_colors) +
labs(
y = "Fabrication Count",
x = NULL,
# title = "Fabricated Claims"
) +
base_theme +
theme(legend.position = "none")
p_right
# title = "CCI Skill Ablation Benchmark",
# subtitle = "N=450 trials | Generator: gpt-5.4-nano | Judges: GPT-5.4 + Claude Sonnet 4.6",
p_combined <- cowplot::plot_grid(p_left, p_right, rel_widths = c(0.7, 0.2), align = 'h', labels = c("A", "B"))
p_combined
ggsave(file.path(out_dir, "s_SkillAblation.png"), p_combined, width = 10, height = 5, dpi = 300, bg = "white")
ggsave(file.path(out_dir, "s_SkillAblation.png"), p_combined, width = 10, height = 5, bg = "white")
