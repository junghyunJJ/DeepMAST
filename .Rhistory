#   C_structured_skill      → "Basic SKILLs"
#   B_unstructured_prose    → "Unstructured Prose"
#   A_no_skill              → "No Skills"
df_scores <- tibble(
Condition = rep(c("Structured SKILLs\n(Guide-Compliant)", "Structured SKILLs\n(Basic)", "Unstructured\nProse", "No Skills"), each = 5),
Dimension = rep(c("Composite", "Faithfulness", "Uncertainty\nHandling", "Spatial\nCalibration", "Overclaiming"), 4),
Mean = c(
3.89, 3.50, 4.51, 4.94, 3.52,   # D (guide-compliant)
3.79, 3.39, 4.44, 4.93, 3.39,   # C (basic structured)
3.59, 3.09, 4.26, 4.96, 3.11,   # B
3.14, 2.79, 3.91, 4.74, 2.74    # A
),
SD = c(
0.460, 0.680, 0.530, 0.270, 0.690,  # D
0.421, 0.663, 0.517, 0.275, 0.668,  # C
0.348, 0.603, 0.485, 0.205, 0.612,  # B
0.278, 0.515, 0.435, 0.463, 0.460   # A
),
N = c(
150, 300, 300, 300, 300,  # D
150, 300, 300, 300, 300,  # C
150, 300, 300, 300, 300,  # B
150, 300, 300, 300, 300   # A
)
)
df_scores <- df_scores %>%
mutate(
SE = SD / sqrt(N),
Condition = factor(Condition,
levels = c("Structured SKILLs\n(Guide-Compliant)", "Structured SKILLs\n(Basic)", "Unstructured\nProse", "No Skills")),
