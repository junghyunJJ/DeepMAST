suppressPackageStartupMessages({
library(tidyverse)
library(patchwork)
})
# ── Paths ──
out_dir <- "docs/benchmarks/cci_skill_ablation"
# ── Data from full_cci_v2_B_fixed_merged_summary.json ──
df_scores <- tibble(
Condition = rep(c("Structured SKILLs", "Unstructured Prose", "No Skills"), each = 5),
Dimension = rep(c("Composite", "Faithfulness", "Uncertainty\nHandling", "Spatial\nCalibration", "Overclaiming"), 3),
Mean = c(
3.79, 3.39, 4.44, 4.93, 3.39,   # C
3.59, 3.09, 4.26, 4.96, 3.11,   # B
3.14, 2.79, 3.91, 4.74, 2.74    # A
),
SD = c(
0.421, 0.663, 0.517, 0.275, 0.668,  # C
0.348, 0.603, 0.485, 0.205, 0.612,  # B
0.278, 0.515, 0.435, 0.463, 0.460   # A
),
N = c(
150, 300, 300, 300, 300,  # C
150, 300, 300, 300, 300,  # B
150, 300, 300, 300, 300   # A
)
)
df_scores <- df_scores %>%
mutate(
SE = SD / sqrt(N),
Condition = factor(Condition,
levels = c("Structured SKILLs", "Unstructured Prose", "No Skills")),
Dimension = factor(Dimension,
levels = c("Composite", "Faithfulness", "Uncertainty\nHandling",
"Spatial\nCalibration", "Overclaiming"))
)
# ── Colorblind-safe palette (matched to fig2 style) ──
condition_colors <- c(
"Structured SKILLs"  = "firebrick3",  # firebrick3
"Unstructured Prose"   = "pink",         # pink
"No Skills"              = "gray60"         # gray60
)
# ── Base theme (matched to fig2) ──
base_theme <- theme_bw() +
theme(
axis.text = element_text(color = "black"),
axis.text.x = element_text(angle = 60, hjust = 1),
legend.position = "bottom",
legend.title = element_blank(),
strip.background = element_blank(),
strip.text = element_text(face = "bold"),
plot.tag = element_text(face = "bold"),
plot.title = element_text(face = "bold", hjust = 0.5, size = 11)
)
####################################################################
### skills (fig3b) #################################################
####################################################################
fig3b <- ggplot(filter(df_scores, Dimension == "Composite"), aes(x = Condition, y = Mean, fill = Condition)) +
geom_bar(stat = "identity",
position = position_dodge(),
alpha = 0.8, color = "black",linewidth = 0.3) +
geom_errorbar(
aes(ymin = Mean - SE, ymax = Mean + SE),
position = position_dodge(width = 0.9),
width = 0.2
) +
scale_fill_manual(values = condition_colors) +
labs(
y = "Composite Score",
# y = "Score",
x = NULL,
# title = "Judge Scores by Dimension"
) +
base_theme +
theme(legend.position = "none", axis.text.x = element_text(angle = 45, hjust = 1)) +
# Significance brackets on Composite (x positions: C=1, B=2, A=3)
# C vs B bracket
annotate("segment", x = 1, xend = 2, y = 4.25, yend = 4.25, linewidth = 0.4) +
annotate("segment", x = 1, xend = 1, y = 4.20, yend = 4.25, linewidth = 0.4) +
annotate("segment", x = 2, xend = 2, y = 4.20, yend = 4.25, linewidth = 0.4) +
annotate("text", x = 1.5, y = 4.33, label = "'***'", parse = TRUE) +
# annotate("text", x = 0.875, y = 4.33, label = "p<10^{-5}~'***'", parse = TRUE, size = 2.2) +
# B vs A bracket
annotate("segment", x = 2, xend = 3, y = 4.55, yend = 4.55, linewidth = 0.4) +
annotate("segment", x = 2, xend = 2, y = 4.50, yend = 4.55, linewidth = 0.4) +
annotate("segment", x = 3, xend = 3, y = 4.50, yend = 4.55, linewidth = 0.4) +
# annotate("text", x = 1.125, y = 4.63, label = "p<10^{-26}~'***'", parse = TRUE, size = 2.2) +
annotate("text", x = 2.5, y = 4.63, label = "'***'", parse = TRUE) +
# C vs A bracket
annotate("segment", x = 1, xend = 3, y = 4.85, yend = 4.85, linewidth = 0.4) +
annotate("segment", x = 1, xend = 1, y = 4.80, yend = 4.85, linewidth = 0.4) +
annotate("segment", x = 3, xend = 3, y = 4.80, yend = 4.85, linewidth = 0.4) +
annotate("text", x = 2, y = 4.93, label = "'***'", parse = TRUE)
# annotate("text", x = 2, y = 4.93, label = "p<10^{-35}~'***'", parse = TRUE, size = 2.2)
fig3b
ggsave(file.path(out_dir, "SkillAblation.png"), fig3b, width = 3, height = 5, dpi = 300, bg = "white")
ggsave(file.path(out_dir, "SkillAblation.png"), fig3b, width = 3, height = 5, bg = "white")
####################################################################
### skills (figS3b) #################################################
####################################################################
