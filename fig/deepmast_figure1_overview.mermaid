%%{init: {
  "securityLevel": "loose",
  "theme": "base",
  "flowchart": {
    "nodeSpacing": 50,
    "rankSpacing": 70,
    "curve": "basis",
    "htmlLabels": true,
    "wrappingWidth": 220
  },
  "themeVariables": {
    "fontFamily": "Helvetica, Arial",
    "fontSize": "14px",
    "primaryColor": "#f5f7fa",
    "primaryBorderColor": "#c9d1d9",
    "primaryTextColor": "#1f2933",
    "lineColor": "#9aa4b2",
    "secondaryColor": "#eef2f7",
    "tertiaryColor": "#ffffff",
    "edgeLabelBackground": "#f5f7faee"
  }
}}%%

flowchart TB

INPUT["<b style='font-size:15px'>Input</b><br/>Spatial transcriptomics dataset<br/>and user-defined biological question"]:::io
OUTPUT["<b style='font-size:15px'>Output</b><br/>Validated findings, target evidence,<br/>and final report"]:::io

subgraph WL["Workflow Layer"]
    direction LR

    SETUP["<b>Study Setup / Pipeline Builder</b><br/><span style='font-size:12px'>Builds the analysis plan from study goals and dataset context.</span>"]:::workflow

    ST["<b>ST Analysis Pipeline</b><br/><span style='font-size:12px'>Runs standardized ST analysis for clustering, neighborhood, pathways, and CCI.</span><br/><span style='font-size:11px;color:#5f6b7a'>clustering | neighborhood | pathway | CCI</span>"]:::workflow

    LR["<b>Prioritized L-R Candidates</b><br/><span style='font-size:12px'>Top-ranked ligand-receptor pairs from hybrid spatial and biological scoring.</span>"]:::artifact

    DBI["<b>Deep Biological Interpreter</b><br/><span style='font-size:12px'>Literature-grounded biological interpretation via specialized subagents.</span><br/><br/><span style='font-size:11px;color:#6e4bb6'><b>Planner → Searcher → Interpreter → Reporter</b></span>"]:::workflow

    DDTD["<b>Deep Drug Target Discovery</b><br/><span style='font-size:12px'>Staged translational target discovery and hypothesis generation.</span><br/><br/><span style='font-size:11px;color:#1a7f37'><b>Evidence Assessor → Deep Diver → Hypothesis Writer → Report Writer</b></span>"]:::workflow

    SYN["<b>Final Report Synthesis</b><br/><span style='font-size:12px'>Combines biological and therapeutic evidence into the final report.</span><br/><span style='font-size:11px;color:#5f6b7a'>drug-target outputs incorporated into final synthesis</span>"]:::workflow
end

subgraph CL["Capability Layer"]
    direction LR

    AG["<b>Hierarchical Agents</b>"]:::capability

    SK["<b style='font-size:16px'>Skills-guided<br/>Reasoning</b><br/><span style='font-size:12px'>progressive disclosure<br/>domain guidance<br/>workflow strategy</span>"]:::skills

    MCP["<b>MCP Tool Interface</b>"]:::capability
end

subgraph RL["Resource Layer"]
    direction LR

    ENG["<b>ST analysis<br/>engines</b>"]:::resource
    MS["<b>MCP servers</b>"]:::resource
    DB["<b>Biological<br/>databases</b>"]:::resource
    RAG["<b>Literature and<br/>full-text RAG</b>"]:::resource
end

H1["<b>HITL</b><br/>study setup"]:::hitl
H2["<b>HITL</b><br/>selection + confirmation"]:::hitl

INPUT --> SETUP --> ST --> LR
LR --> DBI
LR --> DDTD
DBI --> SYN
DDTD --> SYN
SYN --> OUTPUT

AG -.-> SETUP
AG -.-> DBI
AG -.-> DDTD
AG -.-> SYN
SK -.-> DBI
SK -.-> DDTD
MCP -.-> ST
MCP -.-> DDTD

MCP --> ENG
MCP --> MS
SK -.-> DB
SK -.-> RAG

H1 -.-> SETUP
H2 -.-> SYN

classDef workflow fill:#eef4ff,stroke:#6c8ebf,stroke-width:2px,color:#1f2933,rx:16,ry:16
classDef artifact fill:#f7f7f7,stroke:#9aa4b2,stroke-width:1.5px,color:#1f2933,rx:14,ry:14
classDef capability fill:#eef9f0,stroke:#81c784,stroke-width:1.5px,color:#1f2933,rx:12,ry:12
classDef skills fill:#e6f9ed,stroke:#2ea043,stroke-width:2.5px,color:#1f2933,rx:14,ry:14
classDef resource fill:#fff8e8,stroke:#ffcc80,stroke-width:1.5px,color:#1f2933,rx:12,ry:12
classDef io fill:#ffffff,stroke:#9aa4b2,stroke-width:1.5px,color:#1f2933,rx:12,ry:12
classDef hitl fill:#fff4f4,stroke:#f08c8c,stroke-width:1.5px,color:#1f2933,rx:12,ry:12

style WL fill:#f8fbff,stroke:#9aa4b2,stroke-width:2px,stroke-dasharray: 5 5,rx:16,ry:16
style CL fill:#f7fcf7,stroke:#81c784,stroke-width:1.5px,stroke-dasharray: 4 4,rx:12,ry:12
style RL fill:#fffdf5,stroke:#ffcc80,stroke-width:1.5px,stroke-dasharray: 4 4,rx:12,ry:12
