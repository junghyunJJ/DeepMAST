{
  "$id": "post_hitl_eval_v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeepMAST Post-HITL Evaluation Record",
  "type": "object",
  "required": [
    "schema_version",
    "run_meta",
    "hitl_context",
    "artifacts",
    "gold_binding",
    "predicted_claims",
    "matching",
    "scores",
    "eval_status"
  ],
  "properties": {
    "schema_version": { "const": "post_hitl_eval_v1" },
    "run_meta": {
      "type": "object",
      "required": [
        "run_id",
        "dataset_id",
        "agent_git_sha",
        "llm_provider",
        "llm_model",
        "started_at",
        "finished_at"
      ],
      "properties": {
        "run_id": { "type": "string", "minLength": 1 },
        "dataset_id": { "type": "string", "minLength": 1 },
        "agent_git_sha": { "type": "string", "minLength": 1 },
        "llm_provider": { "type": "string", "minLength": 1 },
        "llm_model": { "type": "string", "minLength": 1 },
        "started_at": { "type": "string", "minLength": 1 },
        "finished_at": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "hitl_context": {
      "type": "object",
      "required": [
        "hitl_completed",
        "interpretation_approved",
        "interest_clusters",
        "interest_celltypes",
        "sel_factor",
        "hitl_packet_hash"
      ],
      "properties": {
        "hitl_completed": { "type": "boolean" },
        "interpretation_approved": { "type": "boolean" },
        "interest_clusters": { "type": "array", "items": { "type": ["string", "number"] } },
        "interest_celltypes": { "type": "array", "items": { "type": "string" } },
        "sel_factor": { "type": "string", "minLength": 1 },
        "hitl_packet_hash": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "artifacts": {
      "type": "object",
      "required": [
        "part1_final",
        "part2_final",
        "part3_final",
        "part1_papers",
        "part23_papers",
        "final_report"
      ],
      "properties": {
        "part1_final": { "type": "string", "minLength": 1 },
        "part2_final": { "type": "string", "minLength": 1 },
        "part3_final": { "type": "string", "minLength": 1 },
        "part1_papers": { "type": "string", "minLength": 1 },
        "part23_papers": { "type": "string", "minLength": 1 },
        "final_report": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "gold_binding": {
      "type": "object",
      "required": ["gold_version", "alignment_profile", "evidence_file"],
      "properties": {
        "gold_version": { "type": "string", "minLength": 1 },
        "alignment_profile": { "type": "string", "minLength": 1 },
        "evidence_file": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "predicted_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "pred_id",
          "part",
          "claim_text",
          "claim_type",
          "entities",
          "direction",
          "cited_pmids",
          "novelty_flag"
        ],
        "properties": {
          "pred_id": { "type": "string", "minLength": 1 },
          "part": { "enum": ["part1", "part2", "part3"] },
          "claim_text": { "type": "string", "minLength": 1 },
          "claim_type": { "enum": ["spatial", "pathway", "mechanism", "lr"] },
          "entities": { "type": "array", "items": { "type": "string" } },
          "direction": { "type": "string", "minLength": 1 },
          "cited_pmids": { "type": "array", "items": { "type": "string" } },
          "novelty_flag": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    },
    "matching": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "pred_id",
          "gold_claim_id",
          "status",
          "entity_overlap",
          "direction_match",
          "pmid_alignment"
        ],
        "properties": {
          "pred_id": { "type": "string", "minLength": 1 },
          "gold_claim_id": { "type": ["string", "null"] },
          "status": { "enum": ["TP", "FP", "FN"] },
          "entity_overlap": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
          "direction_match": { "type": "boolean" },
          "pmid_alignment": { "enum": ["strong", "weak", "unsupported"] }
        },
        "additionalProperties": true
      }
    },
    "scores": {
      "type": "object",
      "required": ["part1", "part2", "part3", "overall"],
      "properties": {
        "part1": { "$ref": "#/$defs/partScore" },
        "part2": { "$ref": "#/$defs/partScore" },
        "part3": { "$ref": "#/$defs/partScore" },
        "overall": {
          "type": "object",
          "required": [
            "precision",
            "recall",
            "f1",
            "grounding_validity",
            "strong_alignment_rate",
            "hallucination_rate"
          ],
          "properties": {
            "precision": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
            "recall": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
            "f1": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
            "grounding_validity": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
            "strong_alignment_rate": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
            "hallucination_rate": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "eval_status": { "enum": ["ok", "invalid_precondition", "parse_failed"] }
  },
  "$defs": {
    "partScore": {
      "type": "object",
      "required": ["precision", "recall", "f1"],
      "properties": {
        "precision": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "recall": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "f1": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
