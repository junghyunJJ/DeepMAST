%%{init: {
  "theme": "base",
  "themeVariables": {
    "fontFamily": "Helvetica, Arial",
    "primaryColor": "#f5f7fa",
    "primaryBorderColor": "#c9d1d9",
    "lineColor": "#9aa4b2",
    "secondaryColor": "#eef2f7",
    "tertiaryColor": "#ffffff"
  }
}}%%

flowchart TB

%% ======================
%% Biological Interpreter
%% ======================
subgraph BI[Biological Interpreter]
    ST[Load Preprocessed ST Data]:::module
    STCCI[[ST-CCI Tool]]:::tool
    CCI[Cell–Cell Interaction Results]:::module
    LR[Ligand–Receptor Candidates]:::module
end

%% ======================
%% AI-driven Interpretation Engine
%% ======================
subgraph AI[AI-driven Interpretation Engine]
    P[Planner Agent]:::agent
    S[Searcher Agent]:::agent
    I[Interpreter Agent]:::agent
    R[Reporter Agent]:::agent
end

%% ======================
%% Evidence Sources
%% ======================
subgraph ES[Evidence Sources]

    subgraph LIT[Biomedical Literature]
        direction TB
        DPS[[Dynamic Paper Search]]:::tool
        AR[[Agentic RAG]]:::tool
    end


subgraph DB[Drug & Genetic Databases]
    direction LR

    subgraph DB1[Single-cell / Expression]
        scdb[(CellxGene Census)]
    end

    subgraph DB2[Pathway / Network]
        pathwaydb[(KEGG/Reactome)]
        ppidb[(STRING)]
    end

    subgraph DB3[Genetics / Targets]
        ot[(OpenTargets)]
        gwasdb[(GWAS Catalog)]
        chembl[(ChEMBL)]
        vepdb[(Ensembl VEP)]
    end
end
end

%% ======================
%% Drug Target Discovery Engine
%% ======================
subgraph DT[Drug Target Discovery Engine]

    subgraph EA[Evidence Assessor Agent]
        direction TB
        F1[Stage 1<br/>Biological Context]:::agent
        F2[Stage 2<br/>Validation & Scoring]:::agent
        F3[Stage 3<br/>Deep Evidence Analysis]:::agent
    end

    RS[Results Summary Agent]:::agent

end

%% ======================
%% Outputs
%% ======================
subgraph OUT[Outputs]
    REP[Biological Interpretation Report]:::output
    RANK[Ranked Drug Targets]:::output
end

%% ======================
%% Flow
%% ======================

ST --> STCCI --> CCI --> LR

%% 🔥 Hypothesis Initialization 강조
LR --> P

P --> S --> I --> R

%% Literature loop
S --> LIT
DPS --> AR
AR -.-> DPS

%% 🔥 Multi-source retrieval 강조
%%S -.->|Database Query| DB
EA --> DB

%% Drug target pipeline
LR --> EA

%% 🔥 Funnel-like progression
F1 -->|Refinement| F2 -->|Filtering| F3 -->|Prioritization| RS

RS --> RANK

%% Outputs
R --> REP
RANK --> REP

%% ======================
%% Style Classes
%% ======================

classDef module fill:#ffffff,stroke:#c9d1d9,stroke-width:1.5px,rx:12,ry:12,color:#1f2933
classDef agent fill:#f4f6f8,stroke:#9aa4b2,stroke-width:2px,rx:18,ry:18,color:#1f2933
classDef tool fill:#eceff1,stroke:#b0bec5,stroke-width:1.2px,rx:10,ry:10,color:#1f2933
classDef database fill:#f3e5f5,stroke:#ce93d8,stroke-width:1.5px,rx:10,ry:10,color:#1f2933
classDef output fill:#e8f5e9,stroke:#81c784,stroke-width:1.5px,rx:12,ry:12,color:#1f2933

class ST,CCI,LR module
class P,S,I,R,F1,F2,F3,RS agent
class STCCI,DPS,AR tool
class scdb,pathwaydb,ppidb,ot,gwasdb,chembl,vepdb database
class REP,RANK output