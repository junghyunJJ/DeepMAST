%%{init: {
  "securityLevel": "loose",
  "theme": "base",
  "themeVariables": {
    "fontFamily": "Helvetica, Arial",
    "primaryColor": "#f5f7fa",
    "primaryBorderColor": "#c9d1d9",
    "lineColor": "#9aa4b2",
    "secondaryColor": "#eef2f7",
    "tertiaryColor": "#ffffff"
  }
}}%%

flowchart TB

%% ======================
%% Biological Interpreter Input
%% ======================
START(["Start"]):::terminal -->
ST[/"Inputs<br/>(Preprocessed ST Data)"/]:::io_white

STCCI[["ST-CCI analysis</br>MCP"]]:::tool
CCI["Cell-Cell Interaction</br> Analysis Results"]
%% LR["Ligand-Receptor Candidates"]

%% ======================
%% Biological Interpreter
%% ======================
subgraph INPUT["Biological Interpreter"]
    P("Planner subagent"):::subagent
    S("Searcher subagent"):::subagent
    I("Interpreter subagent"):::subagent
    R("Reporter subagent"):::subagent

    subgraph LIT["Biomedical Literature"]
        direction TB
        DPS[["Dynamic Paper Search"]]:::tool
        RAG[["Full-text RAG"]]:::tool
    end
end


%% ======================
%% Drug Target Discovery
%% ======================
subgraph DT["Drug Target Discovery"]

    subgraph EA_SUB["Evidence Assessor subagent"]
        direction TB
        F2("Stage 1<br/>Validation & Scoring<br/>(<i>ALL genes</i>)")
        %% SEL{"Gene Selection<br/>(<i>FEATURED</i>)"}:::decision
        F1("Stage 2<br/>Biological Context<br/>(<i>FEATURED pairs</i>)")
        F3("Stage 3<br/>Deep Evidence<br/>(<i>FEATURED genes</i>)")

            %% subgraph DBGRP["Drug & Genetic Databases"]
        subgraph DBGRP["Databases"]
            direction TB
            DB_GT[("OpenTargets<br/>GWAS DB<br/>VEP")]:::resource
            DB_PW[("KEGG<br/>Reactome<br/>STRING")]:::resource
            DB_SC[("Single-cell<br/>Census")]:::resource
            DB_DR[("ChEMBL")]:::resource
            %%DB_AR[("PubMed<br/>PubTator3")]:::resource
        end
    end

    %% DPS2[["Dynamic Paper Search"]]:::tool
    SKILL_hypo[["hypothesis<br/>generation"]]:::resource
    RW("Reportse subagnet"):::subagent

end

%% ======================
%% Outputs
%% ======================
DTDS[\"Drug Target Discovery summary"\]:::io_white
REP[\"Biological Interpretation Report"\]:::io_white
END(["End"]):::terminal

%% ======================
%% Flow
%% ======================
ST --> STCCI --> CCI

%% Hypothesis Initialization
CCI --> P
CCI --> F2

P --> S --> I --> R
%% Literature access
S --> LIT
LIT --> I
DPS --> RAG
RAG -.-> DPS

%% Reordered 3-stage funnel
%% F2 -->|"Scoring"| SEL -->|"FEATURED"| F1 -->|"Filtering"| F3 -->|"Prioritization"| RANK
F2 -->|"Scoring"| F1 -->|"Filtering"| F3 --> RW

%% DB access (per-stage)
%%F2 <--> DB_GT
%%F1 <--> DB_PW
%%F1 <--> DB_SC
%%F3 <--> DB_DR

DB_GT --> F2
DB_PW --> F1
DB_SC --> F1
DB_DR --> F3

%% Outputs
R --> REP
SKILL_hypo --> RW
RW --> DTDS
DTDS --> R
REP --> END

%% ======================
%% Style Classes
%% ======================
classDef module fill:#ffffff,stroke:#c9d1d9,stroke-width:1.5px,rx:12,ry:12,color:#1f2933
classDef subagent fill:#fdf8ff,stroke:#ce93d8,stroke-width:1.5px,stroke-dasharray: 5 5,rx:14,ry:14
classDef tool fill:#eceff1,stroke:#b0bec5,stroke-width:1.5px,rx:10,ry:10,color:#1f2933
classDef resource fill:#e8f5e9,stroke:#81c784,stroke-width:1.5px,rx:12,ry:12,color:#1f2933
classDef decision fill:#e8f5e9,stroke:#81c784,stroke-width:1.8px,color:#1f2933
classDef terminal fill:#1f2933,stroke:#1f2933,stroke-width:2px,color:#ffffff
classDef io_white fill:#ffffff,stroke:#7b8a9a,stroke-width:2px,rx:14,ry:14,color:#1f2933

%% Subagent edges: purple dotted

%% Subgraph styles
style INPUT fill:#f3e5f5,stroke:#ce93d8,stroke-width:2px,rx:18,ry:18
style LIT fill:#f8fbff,stroke:#b0bec5,stroke-width:1.5px,rx:12,ry:12
style DT fill:#f3e5f5,stroke:#ce93d8,stroke-width:2px,rx:18,ry:18
style EA_SUB fill:#fdf8ff,stroke:#ce93d8,stroke-width:1.5px,stroke-dasharray: 5 5,rx:14,ry:14
style DBGRP fill:#f7fcf7,stroke:#81c784,stroke-width:1.5px,stroke-dasharray: 4 4,rx:12,ry:12
