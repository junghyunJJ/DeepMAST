flowchart TB

    %% ======================
    %% Core architecture
    %% ======================
    SA[Supervisor Agent]

    subgraph EA[Expert Agents]
        direction LR
        PB[Pipeline\nBuilder]
        PE[Pipeline\nExecutor]
        BI[Biological\nInterpreter]
        DT[Drug Target]
    end

    SK[Skills]
    TOOLS[MCP servers /\nTools]
    DB[(Biological\nDatabases)]

    %% ======================
    %% Relationships
    %% ======================
    SA -->|Orchestrate| EA
    EA -.-> SA

    DT --> BI


    EA -->|MCP /\nTool calling| TOOLS
    TOOLS -.-> EA

    SK -->|"Injection\n(Progressive Disclosure)"| EA
    SK --> |Instructs\nto use tools| TOOLS
    DB --> SK

    %% ======================
    %% Styling
    %% ======================
    classDef supervisor fill:#a8e6a3,stroke:#333,stroke-width:1.6px,color:#111;
    classDef agent fill:#a0c4ff,stroke:#333,stroke-width:1.2px,color:#111;
    classDef layer fill:#ffd6a5,stroke:#333,stroke-width:1.2px,color:#111;
    classDef resource fill:#f3c4fb,stroke:#333,stroke-width:1.2px,color:#111;

    class SA supervisor;
    class PB,PE,BI,DT agent;
    class MCP,SK layer;
    class TOOLS,DB resource;