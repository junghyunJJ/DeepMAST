%%{init: {
  "theme": "base",
  "themeVariables": {
    "fontFamily": "Helvetica, Arial",
    "primaryBorderColor": "#b0b8c1",
    "lineColor": "#8c96a3"
  }
}}%%

flowchart TB

%% =========================
%% PANEL A — INPUT
%% =========================

subgraph A["Input & Data Preparation"]
direction TB

start([Start]):::terminal

load_config["Load Configuration"]:::module
load_st["Load Spatial Data"]:::module
sc_ref["Resolve SC Reference<br/>(if spot-based)"]:::module
validate["Validate & Setup"]:::module
prep["MCP Readiness Check"]:::module
gen_mcp["MCP Generation<br/>(if required)"]:::module
human_confirm{{"Human Confirmation<br/>HITL"}}:::decision

start --> load_config --> load_st
load_st -->|spot-based| sc_ref
load_st -->|single-cell| validate
sc_ref --> validate
validate --> prep
prep -->|missing MCP| gen_mcp --> prep
prep -->|ready| human_confirm

end

%% =========================
%% PANEL B — EXECUTION CORE
%% =========================

subgraph B["Single ReAct Execution Core"]
direction TB

Query["Query"]:::inner
Thinking{{"Pipeline Executor"}}:::agent
ToolCall["Tool Invocation"]:::tool
Answer["Final Answer"]:::inner

Query --> Thinking
Thinking -->|Action| ToolCall
ToolCall -->|Observation| Thinking
Thinking -->|Finish| Answer

subgraph MCP["MCP Tools"]
    mcp_st["Sequential<br/>Thinking"]
    preprocessing["Preprocessing<br/>Modules"]
end


end

%% =========================
%% PANEL C — OUTPUT
%% =========================


save["Save Results"]:::module
end_node([End]):::terminal

save --> end_node



%% =========================
%% MAIN FLOW
%% =========================

human_confirm --> Query
Answer --> save

%% =========================
%% STYLES — Academic Minimal
%% =========================

classDef module fill:#ffffff,stroke:#b0b8c1,stroke-width:1.2px,rx:8,ry:8
classDef decision fill:#f7f9fb,stroke:#8fa1b3,stroke-width:1.2px,rx:8,ry:8
classDef agent fill:#f0f3f6,stroke:#6b7785,stroke-width:2px,rx:12,ry:12
classDef inner fill:#ffffff,stroke:#c5ccd3,stroke-width:1px,rx:6,ry:6
classDef tool fill:#f4f6f8,stroke:#aab4bf,stroke-width:1px,rx:6,ry:6
classDef terminal fill:#2f3b45,color:#ffffff,stroke:#2f3b45,stroke-width:1.5px,rx:12,ry:12