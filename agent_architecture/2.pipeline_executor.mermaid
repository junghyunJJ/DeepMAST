%%{init: {
  "theme": "base",
  "themeVariables": {
    "fontFamily": "Helvetica, Arial",
    "primaryColor": "#f5f7fa",
    "primaryBorderColor": "#c9d1d9",
    "lineColor": "#9aa4b2"
  }
}}%%

flowchart LR

%% =====================================================
%% LEFT PANEL — Input & Preparation
%% =====================================================

subgraph INPUT_PANEL["Input & Preparation"]
direction TB

start([Start]):::terminal

load_config["Load Pipeline Config<br/>(parse config,<br/>derive celltype_mode)"]:::module

load_st["Load ST Data<br/>(HITL: collect h5ad)"]:::module

sc_ref["Resolve SC Reference<br/>(HITL confirmation)"]:::module

validate["Validate Data<br/>(check h5ad,<br/>setup dirs)"]:::module

prep["Prepare Executor<br/>(MCP readiness check)"]:::module

gen_mcp["Generate MCP<br/>(code2MCP / rmcpagent)"]:::module

human_confirm{{"Human Confirm<br/>(HITL execution plan)"}}:::human

end_input_anchor(( )):::hidden
end

%% =====================================================
%% CENTER PANEL — Single ReAct Executor
%% =====================================================

subgraph EXECUTOR["Single ReAct Pipeline Executor"]
direction TB

Query["🗨️ Query"]:::inner
Thinking{{"🧠 Pipeline<br/>Executor"}}:::agent
ToolCall["🔧 Tool Execution"]:::tool
Answer["📝 Answer"]:::answer

Query --> Thinking
Thinking -->|Action| ToolCall
Thinking -->|Finish| Answer
ToolCall -->|Observation| Thinking

subgraph MCP["MCP Tools"]
direction TB
mcp_st["Sequential Thinking"]:::subtool
preprocessing["Preprocessing Tools<br/>(normalization,<br/>cell type analysis,<br/>spatial clustering)"]:::subtool
end

end

%% =====================================================
%% RIGHT PANEL — Output
%% =====================================================

subgraph OUTPUT_PANEL["Output"]
direction TB

save["Save Results"]:::module
end_node([End]):::terminal

end

%% =====================================================
%% FLOW CONNECTIONS
%% =====================================================

start --> load_config

load_config -->|has config| load_st
load_config -->|no config| save

load_st -->|h5ad missing| load_st
load_st -->|spot-based| sc_ref
load_st -->|single-cell| validate

sc_ref --> validate
validate --> prep

prep -->|all MCP ready| human_confirm
prep -->|MCP missing| gen_mcp
gen_mcp --> prep

human_confirm --> Query
Answer --> save
save --> end_node


%% =====================================================
%% STYLE DEFINITIONS
%% =====================================================

classDef module fill:#ffffff,stroke:#c9d1d9,stroke-width:1.5px,rx:12,ry:12,color:#1f2933
classDef human fill:#e8f5e9,stroke:#81c784,stroke-width:1.5px,rx:12,ry:12
classDef agent fill:#f4f6f8,stroke:#9aa4b2,stroke-width:2.5px,rx:18,ry:18
classDef inner fill:#ffffff,stroke:#d1d5db,stroke-width:1.2px,rx:10,ry:10
classDef tool fill:#eceff1,stroke:#b0bec5,stroke-width:1.2px,rx:10,ry:10
classDef answer fill:#fff8e1,stroke:#ffcc80,stroke-width:1.2px,rx:10,ry:10
classDef subtool fill:#f9fafb,stroke:#d1d5db,stroke-dasharray:4 4,rx:8,ry:8
classDef terminal fill:#263238,color:#ffffff,stroke:#263238,stroke-width:2px,rx:16,ry:16
classDef hidden fill:transparent,stroke:transparent