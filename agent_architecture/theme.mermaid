flowchart TB

%% =========================
%% Example Structure (replace with your nodes)
%% =========================

__start__([Start]):::terminal

input_stage[Input Preparation]:::module
executor_core[Pipeline Executor]:::agent
validation{{Result Validation}}:::decision

tool_exec[Tool Execution]:::tool
output_stage[Final Output]:::module

__end__([End]):::terminal


%% =========================
%% Flow
%% =========================

__start__ --> input_stage
input_stage --> executor_core
executor_core --> tool_exec
tool_exec --> validation
validation -->|Approved| output_stage
output_stage --> __end__


%% =========================
%% Style Classes
%% =========================

classDef module fill:#ffffff,stroke:#c9d1d9,stroke-width:1.5px,rx:12,ry:12,color:#1f2933
classDef decision fill:#e3f2fd,stroke:#90caf9,stroke-width:1.5px,rx:12,ry:12
classDef agent fill:#f4f6f8,stroke:#9aa4b2,stroke-width:2px,rx:18,ry:18
classDef tool fill:#eceff1,stroke:#b0bec5,stroke-width:1.2px,rx:10,ry:10
classDef terminal fill:#263238,color:#ffffff,stroke:#263238,stroke-width:2px,rx:15,ry:15

