graph TD
    %% Node
    __start__([<p>__start__</p>]):::first
    
    pipeline_data["Pipeline<br/>Information<br/>load"]
    st_data["ST data<br/>load"]
    sc_data["sc refercne data<br/>load"]
    sc_mcp["sc-reference<br/>selector"]

    sc_thinking{<b>🧠<br/>single cell<br/>reference<br/>Selector</b>}
    human_node{{Human<br/>Decision}}

    subgraph react_agent2["ReAct agnet"]
        Query2[<b>🗨️ Query</b>]
        Thinking2{<b>🧠<br/>Pipeline<br/>Executor</b>}
        Tool2[<b>🔧 Tool</b>]
        Answer2[<b>📝 Answer</b>]
        
        Query2 --> Thinking2
        Thinking2 -.->|<b>Action</b>| Tool2
        Thinking2 -.->|<b>Finish</b>| Answer2
        Tool2 -->|<b>Observation</b>| Thinking2

        subgraph Tool2[MCP tools]
            rMCP[rMCPAgent]
            mcp_st[Sequential<br/>Thinking]
            mcp_dc[Desktop<br/>Commander]
            preprocessing["preprocessing tools<br/> (normalization<br/>cellee type anlaysis,<br/>spatial clusteirng)"]
        end
    end

    __end__([<p>__end__</p>]):::last


    %% Flow
    __start__ --> pipeline_data
    __start__ --> st_data
    __start__ --> sc_data

    sc_data-.->|<b>multiple sc-data</b>| sc_thinking
    pipeline_data --> human_node
    st_data --> human_node
    sc_data-.->|<b>single sc-data</b>| human_node
    sc_thinking --> human_node
    sc_mcp --> sc_thinking

    human_node --> Query2 
    Answer2 --> __end__


    %% color
    classDef validate_infoNode fill:#90ee90,stroke:#fff,stroke-width:2px,color:#000
    classDef default fill:#2d2d3d,stroke:#fff,stroke-width:2px,color:#fff
    classDef queryNode fill:#ff7f50,stroke:#fff,stroke-width:2px,color:#000
    classDef thinkingNode fill:#90ee90,stroke:#fff,stroke-width:2px,color:#000
    classDef toolNode fill:#d3d3d3,stroke:#fff,stroke-width:2px,color:#000
    classDef answerNode fill:#ffd700,stroke:#fff,stroke-width:2px,color:#000
    classDef inReAtc fill:#ab47bc,stroke:#fff,stroke-width:2px,color:#000
    classDef humanNode fill:#4dabf7,stroke:#fff,stroke-width:2px,color:#000


    class pipeline_data,st_data,sc_data inReAtc
    class Platform validate_infoNode
    class Query1,Query2 queryNode
    class sc_thinking,Thinking2 thinkingNode
    class Tool1,Tool2 toolNode
    class Answer1,Answer2 answerNode
    class human_node humanNode

    %% HITL 선 스타일 (파란 긴 대시)
    linkStyle 13 stroke:#0000FF,stroke-width:2px,stroke-dasharray:15 5 