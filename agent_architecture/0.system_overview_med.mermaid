%%{init: {
  "theme": "base",
  "themeVariables": {
    "fontFamily": "Helvetica, Arial",
    "primaryColor": "#f5f7fa",
    "primaryBorderColor": "#c9d1d9",
    "lineColor": "#9aa4b2",
    "secondaryColor": "#eef2f7",
    "tertiaryColor": "#ffffff"
  }
}}%%

flowchart TB

%% =========================
%% User
%% =========================

User["👤 User: Analyze my<br/>spatial transcriptomics data"]:::user

%% =========================
%% Supervisor Agent
%% =========================

Supervisor["Supervisor<br/>Agent"]:::supervisor

%% =========================
%% Expert Agent Layer
%% =========================

subgraph ExpertAgent["Expert Agent"]
    direction LR

    subgraph PB["1. Pipeline Builder"]
        pb_mcp["MCP Client"]:::mcp_client
    end

    subgraph PE["2. Pipeline Executor"]
        pe_mcp["MCP Client"]:::mcp_client
    end

    subgraph BI["3. Biological Interpreter"]
        bi_mcp["MCP Client"]:::mcp_client
    end
end

%% =========================
%% MCP Protocol
%% =========================

MCP_Proto(["MCP Protocol"]):::mcp_proto

%% =========================
%% MCP Server Layer
%% =========================

subgraph MCPServer["MCP Server"]
    direction LR

    S1["1. Article-<br/>download"]:::mcp_tool
    S2["2. MAST-RAG"]:::mcp_tool
    S3["3. rMCPAgent"]:::mcp_tool
    S4["4. SC-reference-<br/>selector"]:::mcp_tool
    S5["5. ST-CCI"]:::mcp_tool
end

%% =========================
%% Annotation Nodes
%% =========================

ann_user["<b>User Input</b><br/>Platform: Visium, MERFISH,<br/>Xenium, seqFISH+<br/>Species · Tissue · Genes"]:::ann_input

ann_pb["<b>Pipeline Builder</b><br/>Info gathering → Config<br/>ReAct loop + HITL<br/>(Auto / Guided / Manual)"]:::ann_desc

ann_pe["<b>Pipeline Executor</b><br/>h5ad → processed results<br/>9-node dynamic graph<br/>SC-ref + MCP execution"]:::ann_desc

ann_bi["<b>Biological Interpreter</b><br/>Wrapper (11-step orchestration)<br/>+ Deep Agent (4-subagent)<br/>+ Drug Target (3-stage funnel)"]:::ann_desc

ann_mcp["<b>MCP Server Details</b><br/>1. PubMed paper download<br/>2. Literature vector search<br/>3. R pipeline (Seurat/COMMOT)<br/>4. CellxGene reference select<br/>5. CCI analysis engine"]:::ann_tools

%% =========================
%% Flow Connections
%% =========================

User --> Supervisor
Supervisor <--> PB
Supervisor <--> PE
Supervisor <--> BI

pb_mcp --- MCP_Proto
pe_mcp --- MCP_Proto
bi_mcp --- MCP_Proto

MCP_Proto --- S1
MCP_Proto --- S2
MCP_Proto --- S3
MCP_Proto --- S4
MCP_Proto --- S5

%% =========================
%% Annotation Positioning
%% =========================

ann_user ~~~ User
ann_pb ~~~ PB
ann_pe ~~~ PE
ann_bi ~~~ BI
ann_mcp ~~~ MCPServer

%% =========================
%% Style Definitions
%% =========================

classDef user fill:#ffffff,stroke:#9aa4b2,stroke-width:1.5px,rx:12,ry:12,color:#1f2933
classDef supervisor fill:#4a86c8,stroke:#3a6ea5,stroke-width:2px,rx:12,ry:12,color:#ffffff
classDef mcp_client fill:#d6e4f0,stroke:#90b4d2,stroke-width:1.2px,rx:8,ry:8,color:#1f2933
classDef mcp_proto fill:#8bc34a,stroke:#689f38,stroke-width:2px,rx:15,ry:15,color:#ffffff
classDef mcp_tool fill:#fff3cd,stroke:#f0c040,stroke-width:1.5px,rx:10,ry:10,color:#1f2933
classDef ann_input fill:#e8f5e9,stroke:#81c784,stroke-width:1.2px,rx:8,ry:8,color:#1b5e20
classDef ann_output fill:#fce4ec,stroke:#f48fb1,stroke-width:1.2px,rx:8,ry:8,color:#880e4f
classDef ann_code fill:#f5f5f5,stroke:#bdbdbd,stroke-width:1px,stroke-dasharray:5 5,rx:8,ry:8,color:#424242
classDef ann_tools fill:#fff8e1,stroke:#ffcc80,stroke-width:1.2px,rx:8,ry:8,color:#e65100
classDef ann_data fill:#e3f2fd,stroke:#90caf9,stroke-width:1.2px,rx:8,ry:8,color:#0d47a1
classDef ann_desc fill:#f3e5f5,stroke:#ce93d8,stroke-width:1.2px,rx:8,ry:8,color:#4a148c

style ExpertAgent fill:#d6e4f0,stroke:#90b4d2,stroke-width:2px,rx:16,ry:16
style PB fill:#b8d4e8,stroke:#7baac4,stroke-width:1.5px,rx:12,ry:12
style PE fill:#b8d4e8,stroke:#7baac4,stroke-width:1.5px,rx:12,ry:12
style BI fill:#b8d4e8,stroke:#7baac4,stroke-width:1.5px,rx:12,ry:12
style MCPServer fill:#fff8e1,stroke:#f0c040,stroke-width:2px,rx:16,ry:16
