%%{init: {
  "theme": "base",
  "themeVariables": {
    "fontFamily": "Helvetica, Arial",
    "primaryColor": "#f5f7fa",
    "primaryBorderColor": "#c9d1d9",
    "lineColor": "#9aa4b2",
    "secondaryColor": "#eef2f7",
    "tertiaryColor": "#ffffff"
  }
}}%%

flowchart TB

%% =========================
%% Main Flow
%% =========================

__start__([Start]):::terminal
info_chain[Information<br/>Collection]:::module
validate_info{{🧠 Information<br/>Validation}}:::decision

generate_pipeline[Pipeline<br/>Generation]:::module
human_node{{Human<br/>Decision}}:::human

update_pipeline[Pipeline<br/>Update]:::module
summary_pipeline[Pipeline<br/>Summary]:::module
__end__([End]):::terminal


%% =========================
%% ReAct Agent Block
%% =========================

subgraph react_agent["ReAct Agent"]
    direction TB

    Query[🗨️ Queries]:::inner
    Thinking{{🧠 Pipeline<br/>Selection}}:::inner_decision
    Tool[🔧 Tool Execution]:::tool
    Answer[📝 Answer]:::answer

    Query --> Thinking
    Thinking -->|Action| Tool
    Thinking -->|Finish| Answer
    Tool -->|Observation| Thinking

    subgraph MCP["MCP Tools"]
        mcp_download[Article Download]
        lc[MAST-RAG]
        mcp_st[Sequential Thinking]
    end
end


%% =========================
%% Flow Connections
%% =========================

__start__ --> info_chain
info_chain --> validate_info
validate_info -->|continue| info_chain
validate_info --> generate_pipeline
generate_pipeline --> human_node

human_node -. &nbsp;1#46;default (HITL)&nbsp; .-> summary_pipeline
human_node -. &nbsp;2#46;update (HITL)&nbsp; .-> update_pipeline
human_node -. &nbsp;3#46;select (HITL)&nbsp; .-> Query


Answer --> summary_pipeline
update_pipeline --> summary_pipeline
summary_pipeline --> __end__


%% =========================
%% Style Definitions
%% =========================

classDef module fill:#ffffff,stroke:#c9d1d9,stroke-width:1.5px,rx:12,ry:12,color:#1f2933
classDef decision fill:#e3f2fd,stroke:#90caf9,stroke-width:1.5px,rx:12,ry:12
classDef human fill:#e8f5e9,stroke:#81c784,stroke-width:1.5px,rx:12,ry:12
classDef inner fill:#f9fafb,stroke:#d1d5db,stroke-width:1.2px,rx:10,ry:10
classDef inner_decision fill:#f3e5f5,stroke:#ce93d8,stroke-width:1.2px,rx:10,ry:10
classDef tool fill:#eceff1,stroke:#b0bec5,stroke-width:1.2px,rx:10,ry:10
classDef answer fill:#fff8e1,stroke:#ffcc80,stroke-width:1.2px,rx:10,ry:10
classDef terminal fill:#263238,color:#ffffff,stroke:#263238,stroke-width:2px,rx:15,ry:15

style react_agent fill:#f4f6f8,stroke:#d0d7de,stroke-width:2px,rx:20,ry:20
style MCP fill:#ffffff,stroke:#d0d7de,stroke-dasharray: 5 5,rx:12,ry:12