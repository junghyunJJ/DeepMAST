%%{init: {
  "securityLevel": "loose",
  "theme": "base",
  "themeVariables": {
    "fontFamily": "Helvetica, Arial",
    "primaryColor": "#f5f7fa",
    "primaryBorderColor": "#c9d1d9",
    "lineColor": "#9aa4b2",
    "secondaryColor": "#eef2f7",
    "tertiaryColor": "#ffffff"
  }
}}%%

flowchart TB

%% ======================
%% Layer 1: Control
%% ======================
SA["Supervisor Agent<br/><i>HITL approval gates</i>"]:::agent

%% ======================
%% Layer 2: Expert Agents
%% ======================
subgraph EA["Expert Agents Layer"]
    direction TB
    PB["Pipeline Builder<br/><i>Study setup &amp; config</i>"]:::agent
    PE["Pipeline Executor<br/><i>MCP-based ST pipeline</i>"]:::agent

    subgraph DA["Deep Agents (DeepAgents Framework)"]
        direction LR
        BI["Biological Interpreter<br/><i>Planner → Searcher →<br/>Interpreter → Reporter</i>"]:::subagent
        DT["Drug Target Discovery<br/><i>Evidence Assessor → Deep Diver →<br/>Hypothesis Writer → Report Writer</i>"]:::subagent
    end

    PMRAG["PubMed RAG<br/><i>Literature Q&amp;A</i>"]:::agent
end

%% ======================
%% Layer 3: Capability Layer
%% ======================
subgraph CL["Capability Layer"]
    SK["Skills<br/>(<i>Progressive Disclosure<br/>Domain Prompts</i>)"]:::green
    MCP[["MCP Protocol<br/>(<i>Tool Interface</i>)"]]:::tool
end

%% ======================
%% Layer 4: Resource Layer
%% ======================
subgraph RL["Resource Layer"]
    TOOLS[["MCP Servers<br/><i>sp-enrich-mcp, biomcp,<br/>pubmed-download, card-r-mcp</i>"]]:::tool
    DB[("Biological Databases<br/><i>OpenTargets, GWAS, ChEMBL,<br/>STRING, KEGG, CellxGene</i>")]:::resource
    LIT[("Literature &amp; RAG<br/><i>PubMed, full-text<br/>vector store</i>")]:::resource
end

%% ======================
%% Core Orchestration
%% ======================
SA <-->|"Orchestrates"| EA

%% ======================
%% Internal Agent Flow
%% ======================
PB -->|"PipelineConfig"| PE
PE -->|"h5ad + analysis results"| DA
BI <-->|"L-R candidates"| DT
PMRAG -.->|"Literature support"| DA

%% ======================
%% Capability Usage
%% ======================
EA -->|"Reads skills"| SK
SK -.->|"Prompt injection"| EA

EA <-->|"Tool calling"| MCP
SK -.->|"Guides tool usage"| MCP

%% ======================
%% Resource Access
%% ======================
MCP <--> TOOLS
MCP <--> DB
SK -.->|"Retrieval strategy"| LIT
PMRAG <--> LIT

%% ======================
%% Layer Alignment (invisible links)
%% ======================
EA ~~~ CL

%% ======================
%% Style Classes
%% ======================
classDef agent fill:#e3f2fd,stroke:#64b5f6,stroke-width:2px,rx:18,ry:18,color:#1f2933
classDef tool fill:#eceff1,stroke:#b0bec5,stroke-width:1.5px,rx:10,ry:10,color:#1f2933
classDef resource fill:#fff8e1,stroke:#ffcc80,stroke-width:1.5px,rx:12,ry:12,color:#1f2933
classDef subagent fill:#ffffff,stroke:#ce93d8,stroke-width:1.5px,color:#1f2933
classDef green fill:#e8f5e9,stroke:#81c784,stroke-width:1.5px,rx:12,ry:12,color:#1f2933

%% Subgraph styles
style EA fill:#f8fbff,stroke:#9aa4b2,stroke-width:2px,stroke-dasharray: 5 5,rx:16,ry:16
style DA fill:#fdf8ff,stroke:#ce93d8,stroke-width:1.5px,stroke-dasharray: 5 5,rx:14,ry:14
style BI fill:#f3e5f5,stroke:#ce93d8,stroke-width:2px,rx:18,ry:18
style DT fill:#f3e5f5,stroke:#ce93d8,stroke-width:2px,rx:18,ry:18
style CL fill:#f7fcf7,stroke:#81c784,stroke-width:1.5px,stroke-dasharray: 4 4,rx:12,ry:12
style RL fill:#fffdf5,stroke:#ffcc80,stroke-width:1.5px,stroke-dasharray: 4 4,rx:12,ry:12
