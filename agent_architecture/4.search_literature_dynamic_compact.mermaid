%%{init: {
  "theme": "base",
  "themeVariables": {
    "fontFamily": "Helvetica, Arial",
    "primaryColor": "#f5f7fa",
    "primaryBorderColor": "#c9d1d9",
    "lineColor": "#9aa4b2",
    "secondaryColor": "#eef2f7",
    "tertiaryColor": "#ffffff",
    "lineColor":"#6b7280"
  }
}}%%

flowchart TD

%% Nodes
START(["Start"]):::terminal
INPUT[/"Inputs<br/>(<i>genes, pathways, celltypes, disease</i>)"/]:::io_white
QUERYGEN["🧠 LLM Query Generation<br/>(5-7 queries)"]:::llm
SEARCH[["BioMCP<br/>(<b><code>article_searcher</code></b> tool)"]]:::tool
COV{"Coverage<br/>Check"}:::check_decision
GAPFILL["🧠 Gap-filling Queries<br/>(3-5 targeted)"]:::llm
DISEASE["Disease Relevance<br/>Post-filter"]:::post
SJR["Journal Quality Sort<br/>(SJR score)"]:::post
OUTPUT[\"Output (articles)"\]:::io_white
END(["End"]):::terminal

%% Flow
START --> INPUT
INPUT --> QUERYGEN
QUERYGEN --> SEARCH
SEARCH --> COV
COV -.->|"gene coverage ≥ 60%<br/>AND<br/>pathway coverage ≥ 50%"| DISEASE
COV -.->|"not met"| GAPFILL
GAPFILL -.->|"back to search<br/>(max 2 rounds)"| SEARCH
DISEASE --> SJR
SJR --> OUTPUT
OUTPUT --> END

%% Style Classes
classDef title fill:none,stroke:none,color:#1f2933,font-size:16px
classDef module fill:#f9fafb,stroke:#666666,stroke-width:1.5px,rx:12,ry:12,color:#1f2933
classDef llm fill:#e3f2fd,stroke:#0000FF,stroke-width:1.5px,rx:12,ry:12,color:#1f2933
classDef check_decision fill:#fff8e1,stroke:#C9A227,stroke-width:1.8px,color:#1f2933
classDef tool fill:#eceff1,stroke:#666666,stroke-width:1.5px,rx:10,ry:10,color:#1f2933
classDef optional fill:#f5f5f5,stroke:#bdbdbd,stroke-width:1.2px,stroke-dasharray: 5 5,rx:10,ry:10,color:#616161
classDef post fill:#f3e5f5,stroke:#800080,stroke-width:1.5px,rx:12,ry:12,color:#1f2933
classDef io_white fill:#ffffff,stroke:#111111,stroke-width:2px,rx:14,ry:14,color:#1f2933
classDef terminal fill:#1f2933,stroke:#1f2933,stroke-width:2px,color:#ffffff
classDef gray fill:#eceff1,stroke:#b0bec5,stroke-width:1.5px,rx:12,ry:12,color:#1f2933
linkStyle default stroke-width:2px;