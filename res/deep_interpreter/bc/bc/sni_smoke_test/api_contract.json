{
  "paths": {
    "/collections/{collection_id}/llm-wiki/rebuild": {
      "post": {
        "tags": [
          "llm-wiki"
        ],
        "summary": "Llm Wiki Rebuild",
        "description": "Synchronously rebuild generated LLM Wiki artifacts for a collection.",
        "operationId": "llm_wiki_rebuild_collections__collection_id__llm_wiki_rebuild_post",
        "parameters": [
          {
            "name": "collection_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Collection Id"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/LLMWikiRebuildRequest"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Request"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LLMWikiRebuildResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/collections/{collection_id}/agentic-search": {
      "post": {
        "tags": [
          "agentic"
        ],
        "summary": "Agentic Search",
        "description": "Run an agentic RAG search with self-correcting retrieval.",
        "operationId": "agentic_search_collections__collection_id__agentic_search_post",
        "parameters": [
          {
            "name": "collection_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Collection Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgenticSearchQuery"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgenticSearchResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AgenticSearchQuery": {
        "properties": {
          "question": {
            "type": "string",
            "title": "Question",
            "description": "The question to answer"
          },
          "search_type": {
            "type": "string",
            "enum": [
              "semantic",
              "keyword",
              "hybrid"
            ],
            "title": "Search Type",
            "description": "Search algorithm",
            "default": "hybrid"
          },
          "search_limit": {
            "type": "integer",
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Search Limit",
            "description": "Max documents per retrieval",
            "default": 5
          },
          "min_score": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Min Score",
            "description": "Minimum relevance score threshold"
          },
          "filter": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Filter",
            "description": "Metadata filter"
          },
          "max_rewrites": {
            "type": "integer",
            "maximum": 10.0,
            "minimum": 0.0,
            "title": "Max Rewrites",
            "description": "Max query rewrite attempts",
            "default": 3
          },
          "llm_provider": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Llm Provider",
            "description": "LLM provider override: auto, openai, google, or ollama"
          },
          "llm_model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Llm Model",
            "description": "LLM model override"
          },
          "llm_temperature": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 2.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Llm Temperature",
            "description": "LLM temperature override"
          },
          "use_wiki_context": {
            "type": "boolean",
            "title": "Use Wiki Context",
            "description": "Use existing non-authoritative LLM Wiki navigation context during generation",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "AgenticSearchQuery",
        "description": "Request body for POST /collections/{id}/agentic-search."
      },
      "AgenticSearchResult": {
        "properties": {
          "generation": {
            "type": "string",
            "title": "Generation",
            "description": "Generated answer",
            "default": ""
          },
          "relevant_documents": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Relevant Documents",
            "description": "Documents deemed relevant"
          },
          "steps": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Steps",
            "description": "Execution trace"
          },
          "query_rewrites": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Query Rewrites",
            "description": "Query rewrite history"
          },
          "rewrite_count": {
            "type": "integer",
            "title": "Rewrite Count",
            "description": "Number of rewrites performed",
            "default": 0
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error",
            "description": "Error message if failed"
          },
          "no_context_found": {
            "type": "boolean",
            "title": "No Context Found",
            "description": "True when no relevant context was found",
            "default": false
          },
          "selected_wiki_pages": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Selected Wiki Pages",
            "description": "Selected non-authoritative wiki page metadata"
          },
          "wiki_context_status": {
            "type": "string",
            "enum": [
              "disabled",
              "selected",
              "missing_pack",
              "no_match",
              "invalid_json",
              "invalid_schema"
            ],
            "title": "Wiki Context Status",
            "description": "Finite status for optional wiki context resolution",
            "default": "disabled"
          },
          "wiki_source_refs": {
            "items": {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            "type": "array",
            "title": "Wiki Source Refs",
            "description": "Structured wiki source refs selected for benchmark observability"
          },
          "wiki_promotion_status": {
            "type": "string",
            "enum": [
              "disabled",
              "not_selected",
              "no_valid_source_refs",
              "promoted",
              "no_matching_source_refs",
              "fetch_failed"
            ],
            "title": "Wiki Promotion Status",
            "description": "Finite status for optional wiki source-ref promotion",
            "default": "disabled"
          },
          "wiki_promoted_document_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Wiki Promoted Document Ids",
            "description": "Document IDs promoted from wiki source refs"
          },
          "retrieved_document_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Retrieved Document Ids",
            "description": "Pre-grade retrieved document IDs after wiki promotion merge"
          }
        },
        "type": "object",
        "title": "AgenticSearchResult",
        "description": "Response body for the agentic search endpoint."
      },
      "LLMWikiRebuildRequest": {
        "properties": {
          "llm_provider": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Llm Provider",
            "description": "LLM provider override: openai, google, or ollama"
          },
          "llm_model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Llm Model",
            "description": "LLM model override"
          },
          "llm_temperature": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 2.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Llm Temperature",
            "description": "LLM temperature override"
          }
        },
        "type": "object",
        "title": "LLMWikiRebuildRequest",
        "description": "Request body for manual collection LLM Wiki rebuilds."
      },
      "LLMWikiRebuildResponse": {
        "properties": {
          "collection_id": {
            "type": "string",
            "title": "Collection Id"
          },
          "status": {
            "type": "string",
            "const": "rebuilt",
            "title": "Status",
            "default": "rebuilt"
          },
          "source_page_count": {
            "type": "integer",
            "title": "Source Page Count"
          },
          "concept_page_count": {
            "type": "integer",
            "title": "Concept Page Count"
          },
          "page_count": {
            "type": "integer",
            "title": "Page Count"
          },
          "chunk_count": {
            "type": "integer",
            "title": "Chunk Count"
          },
          "pack_path": {
            "type": "string",
            "title": "Pack Path"
          }
        },
        "type": "object",
        "required": [
          "collection_id",
          "source_page_count",
          "concept_page_count",
          "page_count",
          "chunk_count",
          "pack_path"
        ],
        "title": "LLMWikiRebuildResponse",
        "description": "Response body for successful collection LLM Wiki rebuilds."
      }
    }
  }
}
