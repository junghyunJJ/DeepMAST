<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <style>
{{ css }}
    </style>
</head>
<body>
    <div class="container">
        <button class="theme-toggle" onclick="toggleTheme()" title="Toggle light/dark theme">&#9681;</button>
        <h1>{{ title }}</h1>
        <p class="subtitle">{{ subtitle }}</p>

        <div class="summary-box">
            <h3>Executive Summary</h3>
            {{ executive_summary_html }}
        </div>

        <div class="analysis-section">
            <h3>Analysis Configuration</h3>
            {{ analysis_config_html }}
        </div>

        <div class="tabs">
            <button class="tab-button active" onclick="openTab(event, 'part1')">Part 1: Spatial & Pathway Analysis</button>
            <button class="tab-button" onclick="openTab(event, 'part2')">Part 2: CCI & NMF Analysis</button>
            <button class="tab-button" onclick="openTab(event, 'part3')">Part 3: L-R Interactions</button>
            <button class="tab-button" onclick="openTab(event, 'summary')">Comprehensive Summary</button>
            <button class="tab-button" onclick="openTab(event, 'therapeutic')">Therapeutic Implications</button>
        </div>

        {% for part in parts %}
        <div id="{{ part.id }}" class="tab-content{% if loop.first %} active{% endif %}">
            <h2>{{ part.title }}</h2>
            <p>{{ part.intro }}</p>
            {% for section in part.sections %}
            <div class="analysis-section">
                <h3>{{ section.number }}. {{ section.title }}</h3>
                {{ section.figure_html }}
                {% if section.table_html %}{{ section.table_html }}{% endif %}
                <div class="interpretation">
                    <h4>Biological Interpretation:</h4>
                    {{ section.interpretation_html }}
                </div>
            </div>
            {% endfor %}
            {% if part.summary_html %}{{ part.summary_html }}{% endif %}
        </div>
        {% endfor %}

        <div id="summary" class="tab-content">
            <h2>Comprehensive Summary: Integrated Multi-Scale Analysis</h2>
            {{ summary_html }}
        </div>

        <div id="therapeutic" class="tab-content">
            <h2>Therapeutic Implications</h2>
            {{ therapeutic_html }}
        </div>

        <div class="metadata">
            <p>Generated by DeepMAST Deep Interpreter (deterministic template mode)</p>
            <p>Date: {{ generation_date }}</p>
        </div>
    </div>

    <script>
{{ js }}
    </script>
</body>
</html>
