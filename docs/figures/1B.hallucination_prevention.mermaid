%%{init: {'theme': 'neutral', 'themeVariables': { 'primaryColor': '#f5f5f5', 'primaryBorderColor': '#333333', 'lineColor': '#333333', 'secondaryColor': '#e8e8e8'}}}%%
flowchart LR
    %% ===== STYLING =====
    classDef searchNode fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,color:#1b5e20
    classDef interpNode fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#0d47a1
    classDef validateNode fill:#fff3e0,stroke:#e65100,stroke-width:2px,color:#bf360c
    classDef decisionNode fill:#fce4ec,stroke:#c2185b,stroke-width:2px,color:#880e4f
    classDef passNode fill:#c8e6c9,stroke:#388e3c,stroke-width:2px,color:#1b5e20
    classDef reviseNode fill:#ffcdd2,stroke:#d32f2f,stroke-width:2px,color:#b71c1c
    classDef novelNode fill:#fff9c4,stroke:#fbc02d,stroke-width:2px,color:#f57f17
    classDef outputNode fill:#eceff1,stroke:#546e7a,stroke-width:2px,color:#37474f,stroke-dasharray: 5 5
    classDef stepLabel fill:#ffffff,stroke:#9e9e9e,stroke-width:1px,color:#424242

    %% ===== STEP 1: LITERATURE-FIRST =====
    subgraph STEP1["Step 1: Literature-First Principle"]
        direction TB
        S1_LABEL["SEARCHER runs BEFORE INTERPRETER"]:::stepLabel
        S1A["Extract biological<br/>context from data"]:::searchNode
        S1B["Search PubMed<br/>(5-phase workflow)"]:::searchNode
        S1C[("Papers<br/>Database")]:::searchNode
        S1A --> S1B --> S1C
    end

    %% ===== STEP 2: CLAIM VALIDATION =====
    subgraph STEP2["Step 2: Claim Validation"]
        direction TB
        S2_LABEL["Every PMID verified via validate_claim_literature"]:::stepLabel
        S2A["Generate<br/>interpretation"]:::interpNode
        S2B["Extract claims<br/>with PMIDs"]:::interpNode
        S2C["validate_claim_literature<br/>tool"]:::validateNode
        S2A --> S2B --> S2C
    end

    %% ===== VALIDATION RESULTS =====
    subgraph RESULTS["Validation Results"]
        direction TB
        R_STRONG["strong"]:::passNode
        R_MODERATE["moderate"]:::passNode
        R_WEAK["weak"]:::reviseNode
        R_UNSUPPORTED["unsupported"]:::novelNode
    end

    %% ===== STEP 3: ACTIONS =====
    subgraph STEP3["Step 3: Evidence-Based Actions"]
        direction TB
        A_KEEP["KEEP<br/>citation"]:::passNode
        A_REVISE["REVISE<br/>claim"]:::reviseNode
        A_NOVEL["Mark as<br/>'Novel Finding'"]:::novelNode
    end

    %% ===== OUTPUT =====
    OUTPUT[/"Final Interpretation<br/>(Literature-Grounded)"/]:::outputNode

    %% ===== CONNECTIONS =====
    STEP1 --> STEP2
    S2C --> RESULTS

    R_STRONG --> A_KEEP
    R_MODERATE --> A_KEEP
    R_WEAK --> A_REVISE
    R_UNSUPPORTED --> A_NOVEL

    A_KEEP --> OUTPUT
    A_REVISE --> S2A
    A_NOVEL --> OUTPUT

    %% ===== QUALITY LOOP ANNOTATION =====
    QUALITY{"Quality<br/>>= 0.7?"}:::decisionNode
    OUTPUT --> QUALITY
    QUALITY -->|"No (max 3 iter)"| S2A
    QUALITY -->|"Yes"| FINAL[/"partN_final.md"/]:::outputNode
