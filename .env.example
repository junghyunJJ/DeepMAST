# DeepMAST environment template
# Copy to `.env` and fill in the values you need. `langgraph dev` loads `.env`
# automatically (see langgraph.json). Never commit the real `.env`.

# ---------------------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------------------
# One of: openai | claude | google | openrouter | ollama | ollama-openai | vllm
# If unset, most graphs default to openai but the DrugTarget graph defaults to openrouter.
LLM_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.5-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# GOOGLE_API_KEY=
# GOOGLE_MODEL=gemini-3.1-flash-lite-preview
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=moonshotai/kimi-k2.5

# Local models (ollama: native API, default port 6000;
# ollama-openai / vllm: OpenAI-compatible API, default port 11434)
# OLLAMA_BASE_URL=http://localhost:6000
# OLLAMA_MODEL defaults differ per agent (e.g. gpt-oss:120b for Pipeline Builder/Executor)
# OLLAMA_MODEL=
# OLLAMA_NUM_CTX applies to the `ollama` provider only
# OLLAMA_NUM_CTX=98304
# OLLAMA_REQUEST_TIMEOUT_SECONDS=7200
# VLLM_MAX_TOKENS=16384
# VLLM_ENABLE_THINKING=true

# ---------------------------------------------------------------------------
# Data and workspace
# ---------------------------------------------------------------------------
# Run directory that holds the spatial analysis outputs and report files
DEEP_INTERPRETER_DATA_DIR=/path/to/run_dir
# Drug Target agent; defaults to DEEP_INTERPRETER_DATA_DIR
# DRUG_TARGET_DATA_DIR=

# ---------------------------------------------------------------------------
# Spatial analysis MCP (required for Deep Interpreter analysis steps 1-11)
# ---------------------------------------------------------------------------
SP_ENRICH_MCP_PYTHON=/path/to/sp_enrich_mcp/.venv/bin/python
# Directory that contains server.py (the code appends /server.py)
SP_ENRICH_MCP_SERVER_PATH=/path/to/sp_enrich_mcp

# ---------------------------------------------------------------------------
# Literature evidence
# ---------------------------------------------------------------------------
# SGCP-RAG MCP server (https://github.com/junghyunJJ/sgcp-rag)
# Required for Pipeline Builder's reference-based option and DeepMAST_RAG;
# the Deep Interpreter falls back to abstract-only search without it.
CCI_RAG_PYTHON=/path/to/sgcp-rag/.venv/bin/python
CCI_RAG_SERVER=/path/to/sgcp-rag/mcpserver/mcp_server.py
CCI_RAG_BASE_URL=http://localhost:8888
# DEEP_INTERPRETER_FIXED_COLLECTION_ID=

# PubMed full-text download MCP (adds new papers to the SGCP-RAG collection)
# PUBMED_MCP_PYTHON=
# PUBMED_MCP_SERVER=

# NCBI E-utilities etiquette (recommended)
PUBMED_EMAIL=you@example.org
# NCBI_API_KEY=
# UNPAYWALL_EMAIL=

# ---------------------------------------------------------------------------
# Reasoning / database MCP servers
# ---------------------------------------------------------------------------
# docker compose -f src/mcpservers/docker/docker-compose.yml up -d
# (used by the Deep Interpreter and Drug Target agents)
BIOMCP_URL=http://localhost:8000/mcp
SEQ_THINKING_URL=http://localhost:8001

# stdio FastMCP servers (path to each server.py)
# REFLECTION_TOOL_SERVER=/path/to/reflection_tool/server.py
# BIOMEDICAL_THINKING_SERVER=/path/to/biomedical_thinking/server.py

# ---------------------------------------------------------------------------
# Pipeline Executor
# ---------------------------------------------------------------------------
# Visium reference selector (ranks two or more provided single-cell references)
# VISIUM_REF_MCP_PYTHON=python
# Project root that contains src/visium_reference_selector/
# VISIUM_REF_MCP_PATH=/path/to/visium_reference_selector_mcp

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# CENSUS_VERSION=2025-11-08
# LANGSMITH_TRACING=false
